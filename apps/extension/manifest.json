{
  "manifest_version": 3,
  "name": "ManipuLens",
  "version": "0.1.0",
  "description": "Detects manipulation techniques in news headlines — not truth. Private by default: scoring runs inside your browser.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ManipuLens"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
